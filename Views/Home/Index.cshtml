@model DocumentConverterApplication.Models.ConverterViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5">
    <!-- Show a single welcome heading if there is no conversion result -->
    @if (Model.ConversionResult == null && Model.IsModelStateValid)
    {
        <div class="text-center mb-5">
            <h1 class="display-4">Welcome to Document Converter</h1>
            <p class="lead">Convert your documents between various formats with ease</p>
            <hr class="my-4">
        </div>
    }

    <!-- Show an error card if there's a validation or conversion issue -->
    @if (!Model.IsModelStateValid || (Model.ConversionResult != null && !Model.ConversionResult.Success))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Conversion Failed</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    @if (!Model.IsModelStateValid)
                    {
                        <p>Please check the form and try again.</p>
                    }
                    else
                    {
                        <p>@Model.ConversionResult?.ErrorMessage</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Converter Selection + File Upload Form -->
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Convert Your Document</h5>
                </div>
                <div class="card-body">
                    <form id="conversionForm" action="/Home/ConvertDocument" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- File Upload -->
                        <div class="mb-4 text-center">
                            <label for="fileUpload" class="form-label">Upload Your Document</label>
                            <div class="file-upload-wrapper">
                                <input type="file" asp-for="UploadedFile" class="form-control-file" id="fileUpload" style="display: none;">
                                <button type="button" class="btn btn-outline-primary btn-lg" onclick="document.getElementById('fileUpload').click()">
                                    <i class="bi bi-upload"></i> Choose File
                                </button>
                                <span id="fileName" class="ml-2">No file chosen</span>
                            </div>
                            <div class="form-text" id="fileTypeHelp">
                                Please upload a file that matches your selected conversion.
                            </div>
                        </div>

                        <!-- Converter Selection -->
                        <div class="mb-4">
                            <label class="form-label">Select Conversion Type</label>
                            <select asp-for="SelectedConverter" class="form-select" id="conversionSelect">
                                <option value="">Select conversion...</option>
                                @foreach (var category in Model.AvailableConverters)
                                {
                                    <optgroup label="@category.Key">
                                        @foreach (var converter in category.Value)
                                        {
                                            <option value="@converter">@converter</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span asp-validation-for="SelectedConverter" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg" id="convertButton">
                                <i class="bi bi-arrow-repeat"></i> Convert Document
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Change help text based on selected converter
        document.getElementById('conversionSelect').addEventListener('change', function () {
            const converter = this.value.toLowerCase();
            const helpText = document.getElementById('fileTypeHelp');

            if (converter.includes('docx')) {
                helpText.textContent = 'Please upload a .docx file';
            } else if (converter.includes('pdf')) {
                helpText.textContent = 'Please upload a .pdf file';
            } else if (converter.includes('html')) {
                helpText.textContent = 'Please upload a .html file';
            } else if (converter.includes('excel') || converter.includes('xlsx')) {
                helpText.textContent = 'Please upload an Excel (.xlsx) file';
            } else if (converter.includes('csv')) {
                helpText.textContent = 'Please upload a .csv file';
            } else {
                helpText.textContent = 'Please upload a file that matches your selected conversion';
            }
        });

        // Update file name display when a file is selected
        document.getElementById('fileUpload').addEventListener('change', function () {
            const fileNameDisplay = document.getElementById('fileName');
            if (this.files.length > 0) {
                fileNameDisplay.textContent = this.files[0].name;
            } else {
                fileNameDisplay.textContent = 'No file chosen';
            }
        });

        // Client-side format check before submitting
        document.getElementById('conversionForm').addEventListener('submit', function (event) {
            const converterValue = document.getElementById('conversionSelect').value.toLowerCase();
            const fileInput = document.getElementById('fileUpload');
            const filePath = fileInput.value.toLowerCase();

            // If there's no file or no converter, let server handle it
            if (!filePath || !converterValue) return;

            // Simple extension check
            let requiredExt = '';
            if (converterValue.includes('docx')) {
                requiredExt = '.docx';
            } else if (converterValue.includes('pdf')) {
                requiredExt = '.pdf';
            } else if (converterValue.includes('html')) {
                requiredExt = '.html';
            } else if (converterValue.includes('excel') || converterValue.includes('xlsx')) {
                requiredExt = '.xlsx';
            } else if (converterValue.includes('csv')) {
                requiredExt = '.csv';
            }

            if (requiredExt && !filePath.endsWith(requiredExt)) {
                event.preventDefault();
                alert(`Error: Please upload a file with the '${requiredExt}' extension for this conversion type.`);
            }
        });
    </script>
}